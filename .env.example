# Supabase — get these from your Supabase project → Settings → API
# NOTE: This is a TEMPLATE. Never put real keys here — it is committed to git.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email (SMTP via Nodemailer) — Gmail recommended
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Admin email - always CC'd on every assessment email
ADMIN_EMAIL=admin@yourdomain.com

# App URL (for email links)
NEXT_PUBLIC_APP_URL=https://bms-assessment.vercel.app/
